# SimuLearn Frontend — environment variables
# Copy to .env.local for local dev. On Vercel, set these under
# Project → Settings → Environment Variables, then redeploy (NEXT_PUBLIC_*
# values and rewrites are baked in at build time).

# Local dev: matches the backend's PORT (see simlearn-backend/.env, default 5000).
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Vercel production (backend on Railway): the browser calls /api/v1 on the
# Vercel domain and next.config.ts rewrites it to BACKEND_URL, keeping the
# refresh cookie first-party. Large uploads bypass the proxy via
# NEXT_PUBLIC_UPLOAD_API_URL.
# NEXT_PUBLIC_API_URL=/api/v1
# BACKEND_URL=https://<your-backend>.up.railway.app
# NEXT_PUBLIC_UPLOAD_API_URL=https://<your-backend>.up.railway.app/api/v1
